Meta.DisplayName=Farming Simulator 25
Meta.Description=Serveur dédié Farming Simulator 25 sous Wine/Docker (image communautaire wine-gameservers). Licence serveur Giants requise.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=TeamKit (image Docker : Toetje585 / wine-gameservers)
Meta.URL=https://github.com/hydrocut/AMPTemplates-FS25
Meta.DisplayImageSource=steam:2300320
Meta.EndpointURIFormat=
Meta.ConfigManifest=fs25config.json
Meta.MetaConfigManifest=fs25metaconfig.json
Meta.ConfigRoot=fs25.kvp
Meta.MinAMPVersion=2.5.0.8
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ConfigReleaseState=Beta
Meta.NoCommercialUsage=False
Meta.ConfigVersion=2
Meta.ReleaseNotes=Version initiale : pilotage docker run de l'image toetje585/arch-fs25server.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=b98003ed-ed91-45b5-935e-8904dfb781cc
Meta.ImportableExtensions=[]

App.DisplayName=Farming Simulator 25
App.RootDir=./fs25/
App.BaseDirectory=./fs25/
App.ExecutableWin=
App.ExecutableLinux=/usr/bin/docker
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=run --rm --name {{ContainerName}} -e PUID={{HostUid}} -e PGID={{HostGid}} -e VNC_PASSWORD={{VncPassword}} -e WEB_USERNAME={{WebUsername}} -e WEB_PASSWORD={{WebPassword}} -e SERVER_NAME="{{ServerName}}" -e SERVER_PASSWORD="{{ServerPassword}}" -e SERVER_ADMIN="{{ServerAdmin}}" -e SERVER_PLAYERS={{$MaxUsers}} -e SERVER_PORT=10823 -e SERVER_REGION={{ServerRegion}} -e SERVER_MAP={{ServerMap}} -e SERVER_DIFFICULTY={{ServerDifficulty}} -e SERVER_PAUSE={{ServerPause}} -e SERVER_SAVE_INTERVAL={{SaveInterval}} -e SERVER_STATS_INTERVAL={{StatsInterval}} -e SERVER_CROSSPLAY={{Crossplay}} -e AUTOSTART_SERVER={{AutostartServer}} -e ENABLE_STARTUP_SCRIPTS=no -v {{$FullBaseDir}}config:/opt/fs25/config -v {{$FullBaseDir}}game:/opt/fs25/game -v {{$FullBaseDir}}dlc:/opt/fs25/dlc -v {{$FullBaseDir}}installer:/opt/fs25/installer -p {{$GamePort}}:10823/tcp -p {{$GamePort}}:10823/udp -p {{$WebPanelPort}}:7999/tcp -p {{$VncWebPort}}:6080/tcp -p {{$VncPort}}:5900/tcp --cap-add SYS_NICE toetje585/arch-fs25server:latest
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=-{0} {1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=90
App.ExitString=quit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0

App.Ports=@IncludeJson[fs25ports.json]

App.AdminPortRef=WebPanelPort
App.PrimaryApplicationPortRef=GamePort
App.MaxUsers=16
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO

App.UpdateSources=@IncludeJson[fs25updates.json]

App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.Compatibility=None
App.RapidStartup=False
App.SmartExcludeSupported=False
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=Immediate

Console.ThrowawayMessageRegex=
Console.AppReadyRegex=
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.SuppressLogAtStart=False

Limits.SleepMode=False
Limits.AutoRetryCount=2
